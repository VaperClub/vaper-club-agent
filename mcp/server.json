{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "club.vaper/vaper-club",
  "title": "Vaper.club",
  "description": "Read-only vape industry data: posts, brands, shops, product search, comparison and reviews.",
  "version": "1.0.0",
  "websiteUrl": "https://vaper.club/developers/mcp",
  "repository": {
    "url": "https://github.com/VaperClub/vaper-club-agent",
    "source": "github",
    "subfolder": "mcp-server"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "vaper-club-mcp",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VAPER_CLUB_API_BASE_URL",
          "description": "Vaper.club Public API base URL.",
          "isRequired": false,
          "default": "https://api.vaper.club/public-api/v1/"
        },
        {
          "name": "VAPER_CLUB_API_TIMEOUT",
          "description": "API request timeout in seconds.",
          "isRequired": false,
          "default": "15"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.vaper.club/mcp"
    }
  ]
}
